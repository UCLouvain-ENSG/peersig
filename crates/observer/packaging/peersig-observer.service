# PeerSig dedicated observer: sends the day's items each night (UTC).
# Settings: /etc/peersig/observer.conf, written by `peersig-observer configure`.
[Unit]
Description=PeerSig dedicated observer (daily reports)
Documentation=https://github.com/UCLouvain-ENSG/peersig/blob/main/docs/observers.md
Wants=network-online.target peersig-probe.service
After=network-online.target peersig-probe.service
ConditionPathExists=/etc/peersig/observer.conf

[Service]
User=peersig
Group=peersig
ExecStart=/usr/bin/peersig-observer run
Restart=always
RestartSec=60
# It reads the probe's logs and its settings, and talks to the server.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
