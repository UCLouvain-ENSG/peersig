# PeerSig capture probe, without a desktop (package peersig-headless).
# Started by peersig.service, once `peersig configure` ran.
[Unit]
Description=PeerSig capture probe
Documentation=https://github.com/UCLouvain-ENSG/peersig/blob/main/docs/headless.md
After=network.target

[Service]
# Not root: the capabilities it needs to capture and to find the process
# behind each connection, as the desktop packages give the probe.
User=peersig
Group=peersig
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
StateDirectory=peersig
StateDirectoryMode=0700
# Daily files peersig-<date>.jsonl, kept 14 days, readable by peersig only.
ExecStart=/usr/lib/peersig/peersig-probe run --dir /var/lib/peersig/logs --quiet
Restart=always
RestartSec=10
# On a machine with no traffic at all, a capture read may not return to
# see the stop request: do not wait the default 90 s for it.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
