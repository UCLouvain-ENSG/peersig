{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeerSig",
  "version": "0.1.20",
  "identifier": "be.uclouvain.peersig",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "PeerSig", "width": 900, "height": 680, "minWidth": 640, "minHeight": 480, "visible": false, "center": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "msi"],
    "category": "Utility",
    "shortDescription": "Volunteer measurement: which apps send which TLS fingerprints",
    "longDescription": "PeerSig ties the TLS/QUIC fingerprints (JA4) your computer sends to the applications that send them, and contributes them to a research study as anonymous ballots.",
    "copyright": "UCLouvain",
    "license": "Apache-2.0",
    "homepage": "https://peersig.org",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/peersig-probe"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "linux": {
      "deb": { "depends": ["libpcap0.8"], "postInstallScript": "packaging/postinst.sh" },
      "rpm": { "depends": ["libpcap.so.1()(64bit)"], "postInstallScript": "packaging/postinst.sh" }
    }
  }
}
